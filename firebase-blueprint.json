          }
        },
        "published": {
          "description": "The live configuration served to public visitors.",
          "fields": {
            "projects": "array",
            "sections": "array",
            "theme": "object",
            "content": "object",
            "branding": "object",
            "media": "array",
            "updatedAt": "timestamp"
          }
        }
      }
    }
  }
}
